<mxfile host="Electron" version="21.0.0" type="device">
  <diagram id="class_diagram" name="Class Diagram (with Design Patterns)">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="box_legend" value="«Design Patterns Applied»&#xa;• Singleton: Spring Service / Component Beans&#xa;• Factory Method: TaxInvoiceFactory, ProductWarrantyFactory&#xa;• Strategy Pattern: DiscountStrategy &amp; Implementations&#xa;• Builder Pattern: Lombok @Builder on Entities &amp; DTOs" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;align=left;spacingLeft=10;fontStyle=0;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cd_ctrl" value="«RestController»&#xa;SaleOrderController&#xa;--&#xa;- saleService: SaleService&#xa;--&#xa;+ createSaleOrder(request): ResponseEntity&#xa;+ getSaleOrderById(id): ResponseEntity" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="30" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cd_service_if" value="«interface»&#xa;SaleService&#xa;--&#xa;+ createSaleOrder(request): SaleOrderResponse&#xa;+ getSaleOrderById(id): SaleOrderResponse" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="190" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cd_service_impl" value="«Service / Singleton»&#xa;SaleServiceImpl&#xa;--&#xa;- saleOrderRepository: SaleOrderRepository&#xa;- customerRepository: CustomerRepository&#xa;- taxInvoiceFactory: TaxInvoiceFactory&#xa;- productWarrantyFactory: ProductWarrantyFactory&#xa;- discountStrategyResolver: DiscountStrategyResolver&#xa;--&#xa;+ createSaleOrder(request): SaleOrderResponse" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cd_strat_if" value="«Strategy Interface»&#xa;DiscountStrategy&#xa;--&#xa;+ calculateDiscount(subtotal, val): BigDecimal" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="840" y="190" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cd_strat_fixed" value="«Concrete Strategy»&#xa;FixedAmountDiscountStrategy&#xa;--&#xa;+ calculateDiscount(subtotal, val): BigDecimal" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cd_strat_percent" value="«Concrete Strategy»&#xa;PercentageDiscountStrategy&#xa;--&#xa;+ calculateDiscount(subtotal, val): BigDecimal" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1050" y="320" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cd_strat_res" value="«Context / Resolver»&#xa;DiscountStrategyResolver&#xa;--&#xa;- strategies: Map&lt;String, DiscountStrategy&gt;&#xa;--&#xa;+ getStrategy(name): DiscountStrategy" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="840" y="440" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cd_fac_inv" value="«Factory Method»&#xa;TaxInvoiceFactory&#xa;--&#xa;+ createTaxInvoice(no, req, grandTotal): TaxInvoice" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cd_fac_war" value="«Factory Method»&#xa;ProductWarrantyFactory&#xa;--&#xa;+ createWarranty(code, imei, model): ProductWarranty" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cd_repo" value="«interface / Repository»&#xa;SaleOrderRepository&#xa;--&#xa;+ findBySaleCode(code): Optional&lt;SaleOrder&gt;&#xa;+ findByCustomer(customer, pageable): Page&lt;SaleOrder&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
